/*
 * SQL Extension Test Configuration
 * 
 * This configuration file is for testing that the nf-trino plugin
 * SQL extension loads properly without requiring actual database connections.
 */

plugins {
    id 'nf-trino'
}

// Process configuration
process {
    executor = 'local'
    cpus = 1
    memory = '512 MB'
}

// Execution report
report {
    enabled = true
    file = 'sql-extension-test-report.html'
}

timeline {
    enabled = true
    file = 'sql-extension-test-timeline.html'
} 