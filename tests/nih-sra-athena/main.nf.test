nextflow_pipeline {
    name "Test nih-sra-athena pipeline"
    script "./main.nf"
    config "./nextflow.config"
    
    test("NIH SRA Athena pipeline syntax validation") {
        when {
            params {
                aws_glue_db = 'test_db'
                aws_glue_db_table = 'test_table'
                organism = 'Test organism'
                assay_type = 'WGS'
                query_limit = 5
            }
        }
        
        then {
            // Test that workflow compiles without syntax errors
            assert workflow.success || workflow.failed
            if (workflow.failed) {
                assert !workflow.errorMessage.contains("Script compilation error")
            }
            if (workflow.success) {
                assert workflow.trace.tasks().size() == 0 // No processes in this pipeline
            }
        }
    }
    
    test("NIH SRA Athena with Homo sapiens WGS") {
        when {
            params {
                aws_glue_db = 'sra_metadata_us_east_1'
                aws_glue_db_table = 'metadata'
                organism = 'Homo sapiens'
                assay_type = 'WGS'
                query_limit = 100
            }
        }
        
        then {
            // Test that workflow compiles without syntax errors
            assert workflow.success || workflow.failed
            if (workflow.failed) {
                assert !workflow.errorMessage.contains("Script compilation error")
            }
            if (workflow.success) {
                assert params.organism == 'Homo sapiens'
                assert params.assay_type == 'WGS'
                assert params.query_limit == 100
            }
        }
    }
    
    test("NIH SRA Athena with RNA-Seq assay") {
        when {
            params {
                aws_glue_db = 'sra_metadata_us_east_1'
                aws_glue_db_table = 'metadata'
                organism = 'Mus musculus'
                assay_type = 'RNA-Seq'
                query_limit = 50
            }
        }
        
        then {
            // Test that workflow compiles without syntax errors
            assert workflow.success || workflow.failed
            if (workflow.failed) {
                assert !workflow.errorMessage.contains("Script compilation error")
            }
            if (workflow.success) {
                assert params.organism == 'Mus musculus'
                assert params.assay_type == 'RNA-Seq'
                assert params.query_limit == 50
            }
        }
    }
}