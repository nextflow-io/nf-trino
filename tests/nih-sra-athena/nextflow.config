/*
 * NIH SRA Athena Configuration
 * 
 * This configuration file provides comprehensive setup for querying
 * the NIH SRA Athena database with multiple query types.
 */

plugins {
    id 'nf-trino'
}

params {
    // AWS Glue database configuration
    aws_glue_db = 'sra_metadata_us_east_1'
    aws_glue_db_table = 'metadata'
    
    // Query parameters
    organism = 'Homo sapiens'
    assay_type = 'WGS'
    query_limit = 100
}

sql {
    db {
        awsathena {
            // Replace these with your actual AWS configuration
            url = 'jdbc:athena://Region=us-east-1;OutputLocation=s3://your-athena-results-bucket/query-results/;CredentialsProvider=DefaultChain;'
        }
    }
}

// Process configuration
process {
    executor = 'local'
    cpus = 1
    memory = '2 GB'
    
    // Retry configuration for AWS operations
    errorStrategy = 'retry'
    maxRetries = 3
}

// Execution report
report {
    enabled = true
    file = 'nih-sra-athena-report.html'
}

timeline {
    enabled = true
    file = 'nih-sra-athena-timeline.html'
}

// AWS Configuration hints
// You can also set these via environment variables:
// AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_DEFAULT_REGION 