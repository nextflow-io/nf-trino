/*
 * Simple Athena Test Configuration
 * 
 * This configuration file is for testing AWS Athena connection using boto3 directly.
 * AWS credentials should be configured via environment variables or AWS credentials file.
 */

plugins {
    id 'nf-trino'
}

params {
    // S3 bucket for Athena query results (required)
    s3_bucket = null
    
    // Query parameters
    query_limit = 10
}

// Process configuration
process {
    executor = 'local'
    cpus = 1
    memory = '2 GB'
    
    // Retry configuration for network operations
    errorStrategy = 'retry'
    maxRetries = 3
}

// Execution report
report {
    enabled = true
    file = 'athena-test-report.html'
}

timeline {
    enabled = true
    file = 'athena-test-timeline.html'
}

// AWS Configuration (optional - can be set via environment variables)
// aws.region = 'us-east-1'
// aws.accessKey = 'YOUR_ACCESS_KEY'
// aws.secretKey = 'YOUR_SECRET_KEY' 