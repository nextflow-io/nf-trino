/*
 * Starburst configuration examples
 * 
 * Choose the appropriate configuration based on your Starburst deployment:
 * - Starburst Galaxy (fully managed cloud)
 * - Starburst Enterprise (self-managed)
 */

plugins {
    id 'nf-trino'
}

sql {
    db {
        // Starburst Galaxy configuration (fully managed cloud)
        starburst_galaxy {
            url = 'jdbc:trino://your-cluster.galaxy.starburst.io:443/catalog/schema?SSL=true'
            user = 'your-username'
            password = 'your-password'
        }
        
        // Starburst Enterprise configuration (self-managed)
        starburst_enterprise {
            url = 'jdbc:trino://your-starburst-host:8080/catalog/schema'
            user = 'your-username'
            // Uncomment for SSL connections:
            // url = 'jdbc:trino://your-starburst-host:443/catalog/schema?SSL=true'
            // password = 'your-password'  // if using LDAP authentication
        }
        
        // Advanced configuration with connection properties
        starburst_advanced {
            url = 'jdbc:trino://your-starburst-host:8080/hive/default'
            user = 'analytics-user'
            properties = [
                SSL: 'true',
                SSLVerification: 'FULL',
                source: 'nextflow-analytics',
                clientTags: 'batch,genomics',
                sessionProperties: 'query_max_memory=10GB;query_max_run_time=1h',
                roles: 'hive:analyst;system:monitor',
                timezone: 'UTC'
            ]
        }
        
        // JWT authentication example
        starburst_jwt {
            url = 'jdbc:trino://your-starburst-host:8080/catalog/schema'
            user = 'your-username'
            properties = [
                accessToken: 'your-jwt-token'
            ]
        }
        
        // OAuth 2.0 authentication example
        starburst_oauth {
            url = 'jdbc:trino://your-starburst-host:8080/catalog/schema?externalAuthentication=true'
            user = 'your-username'
        }
        
        // Default starburst configuration (used by example)
        starburst {
            url = 'jdbc:trino://your-starburst-host:8080/catalog/schema'
            driver = 'starburst'
            user = 'your-username'
            // password = 'your-password'
        }
    }
} 