/*
 * Common test configuration for nf-trino plugin examples
 *
 * This configuration is used when running tests from the tests directory.
 * Individual test directories can override these settings.
 */

plugins {
    id 'nf-trino'
}

// Process configuration
process {
    executor = 'local'
    cpus = 1
    memory = '1 GB'
}

// Execution report
report {
    enabled = false  // Disable for tests to avoid conflicts
}

timeline {
    enabled = false  // Disable for tests to avoid conflicts
}
