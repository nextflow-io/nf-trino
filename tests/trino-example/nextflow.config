/*
 * Trino Configuration Example
 * 
 * This configuration file demonstrates how to configure the nf-trino plugin
 * to connect to a Trino cluster.
 * 
 * Usage: nextflow run main.nf -plugins nf-trino@0.1.0
 */

plugins {
    id 'nf-trino'
}

// Trino database configuration
sql {
    db {
        trino {
            // Basic connection settings
            url = 'jdbc:trino://trino-coordinator.example.com:8080/hive/default'
            user = 'nextflow'
            
            // Optional: Password for LDAP authentication
            // password = 'your-password'
            
            // Optional: Additional connection properties
            // properties = [
            //     SSL: 'true',
            //     SSLVerification: 'FULL',
            //     source: 'nextflow-analytics',
            //     clientTags: 'batch,genomics',
            //     sessionProperties: 'query_max_memory=10GB;query_max_run_time=1h'
            // ]
        }
    }
}

// Example parameters for different Trino setups
params {
    // For local Trino development
    // trino_catalog = 'memory'
    // trino_schema = 'default'
    
    // For Hive catalog
    trino_catalog = 'hive'
    trino_schema = 'default'
    
    // For PostgreSQL catalog
    // trino_catalog = 'postgresql'
    // trino_schema = 'public'
    
    // Query limits
    limit = 10
}

// Process configuration
process {
    executor = 'local'
    cpus = 1
    memory = '1 GB'
}

// Execution report
report {
    enabled = true
    file = 'trino-report.html'
}

timeline {
    enabled = true
    file = 'trino-timeline.html'
} 