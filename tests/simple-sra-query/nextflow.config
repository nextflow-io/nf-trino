/*
 * Simple SRA Query Configuration
 * 
 * This configuration follows the established pattern for NIH SRA Athena queries.
 * Replace the placeholder values with your actual AWS credentials and resources.
 */

plugins {
    id 'nf-trino'
}

params {
    // AWS Glue database configuration
    aws_glue_db = 'sra_metadata_us_east_1'
    aws_glue_db_table = 'metadata'
    
    // Query parameters
    organism = 'Mycobacterium tuberculosis'
    limit = 10
}

sql {
    db {
        awsathena {
            // Replace these with your actual AWS configuration
            url = 'jdbc:athena://Region=us-east-1;OutputLocation=s3://your-athena-results-bucket/query-results/;CredentialsProvider=DefaultChain;'
        }
    }
}

// Process configuration
process {
    executor = 'local'
    cpus = 1
    memory = '1 GB'
}

// Execution report
report {
    enabled = true
    file = 'sra-query-report.html'
}

timeline {
    enabled = true
    file = 'sra-query-timeline.html'
} 