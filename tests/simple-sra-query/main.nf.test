nextflow_pipeline {
    name "Test simple-sra-query pipeline"
    script "./main.nf"
    config "./nextflow.config"
    
    test("Simple SRA query pipeline syntax validation") {
        when {
            params {
                aws_glue_db = 'test_db'
                aws_glue_db_table = 'test_table'
                organism = 'Test organism'
                limit = 5
            }
        }
        
        then {
            // Test that workflow compiles without syntax errors
            assert workflow.success || workflow.failed
            if (workflow.failed) {
                assert !workflow.errorMessage.contains("Script compilation error")
            }
            if (workflow.success) {
                assert workflow.trace.tasks().size() == 0 // No processes in this pipeline
            }
        }
    }
    
    test("Simple SRA query with Mycobacterium tuberculosis") {
        when {
            params {
                aws_glue_db = 'sra_metadata_us_east_1'
                aws_glue_db_table = 'metadata'
                organism = 'Mycobacterium tuberculosis'
                limit = 10
            }
        }
        
        then {
            // Test that workflow compiles without syntax errors
            assert workflow.success || workflow.failed
            if (workflow.failed) {
                assert !workflow.errorMessage.contains("Script compilation error")
            }
            if (workflow.success) {
                assert params.organism == 'Mycobacterium tuberculosis'
                assert params.limit == 10
            }
        }
    }
    
    test("Simple SRA query with custom database") {
        when {
            params {
                aws_glue_db = 'custom_sra_db'
                aws_glue_db_table = 'custom_metadata'
                organism = 'Homo sapiens'
                limit = 50
            }
        }
        
        then {
            // Test that workflow compiles without syntax errors
            assert workflow.success || workflow.failed
            if (workflow.failed) {
                assert !workflow.errorMessage.contains("Script compilation error")
            }
            if (workflow.success) {
                assert params.aws_glue_db == 'custom_sra_db'
                assert params.aws_glue_db_table == 'custom_metadata'
                assert params.organism == 'Homo sapiens'
            }
        }
    }
}