/*
 * Example configuration for AWS Athena integration
 * Replace the placeholder values with your actual AWS credentials and resources
 */

plugins {
    id 'nf-trino'
}

params {
    aws_glue_db = 'sra-glue-db'
    aws_glue_db_table = 'metadata'
}

sql {
    db {
        awsathena {
            url = 'jdbc:awsathena://AwsRegion=us-east-1;S3OutputLocation=s3://your-athena-results-bucket/results/'
            user = 'YOUR_AWS_ACCESS_KEY'
            password = 'YOUR_AWS_SECRET_KEY'
        }
    }
} 