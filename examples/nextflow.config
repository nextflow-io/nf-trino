/*
 * Example configuration for AWS Athena integration
 * Replace the placeholder values with your actual AWS credentials and resources
 */

// Nextflow configuration for NIH SRA Athena connection
// Based on: https://www.ncbi.nlm.nih.gov/sra/docs/sra-athena/

plugins {
    id 'nf-trino'
}

params {
    // AWS Glue database configuration
    aws_glue_db = 'sra_metadata_us_east_1'
    aws_glue_db_table = 'metadata'
    
    // Query parameters
    organism = 'Homo sapiens'
    assay_type = 'WGS'
    query_limit = 100
}

sql {
    db {
        awsathena {
            // Replace these with your actual AWS configuration
            url = 'jdbc:awsathena://AwsRegion=us-east-1;S3OutputLocation=s3://your-athena-results-bucket/query-results/'
            user = '<YOUR_AWS_ACCESS_KEY>'
            password = '<YOUR_AWS_SECRET_KEY>'
        }
    }
} 